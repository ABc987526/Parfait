  "excluded_surfaces": [
    {
      "id": "ext.oauth_and_turnstile_webview_dom",
      "category": "external_auth_captcha",
      "affected_routes": ["/login/web", "/recommended/spotlight/article/:articleId"],
      "reason": "Third-party Pixiv OAuth login form and Cloudflare Turnstile/CAPTCHA verification widgets rendered inside external WebView origins are external anti-bot/auth boundaries and must never be bypassed or automated."
    },
    {
      "id": "ext.os_file_pickers_and_saf",
      "category": "os_native_picker_or_share",
      "affected_routes": [
        "/reverse-image",
        "/recommended/local-novels",
        "/recommended/profile/:userId/edit",
        "/settings/download/destination",
        "/settings/backup"
      ],
      "reason": "Native OS file dialogs (Win32 IFileOpenDialog, Android SAF/DocumentTree, XDG Desktop Portal, PHPicker/UIDocumentPicker) run out-of-process under OS chrome and cannot be portably driven inside headless or sandboxed recorders."
    },
    {
      "id": "ext.os_native_share_sheets",
      "category": "os_native_picker_or_share",
      "affected_routes": [
        "/recommended/illust/:illustId",
        "/recommended/novel/:novelId",
        "/recommended/spotlight/article/:articleId"
      ],
      "reason": "Native Android/iOS/Windows share sheets spawned via share_plus belong to OS system processes outside the Parfait window tree."
    },
    {
      "id": "ext.external_browser_handoff",
      "category": "external_browser_handoff",
      "affected_routes": [
        "/login/web",
        "/recommended/spotlight/article/:articleId",
        "/settings/about"
      ],
      "reason": "External HTTP(S) destinations opened via launchUrl (including Linux WebView fallback after clicking Open in Browser and external profile/pixivision/release URLs) leave the Parfait process boundary."
    },
    {
      "id": "ext.os_desktop_and_taskbar_chrome",
      "category": "desktop_os_chrome_outside_frame",
      "affected_routes": ["/recommended"],
      "reason": "OS taskbar, system tray popup menu chrome outside DesktopWindowFrame, Start menu, and desktop wallpaper sit outside Parfait's client/non-client window frame."
    }
  ]
}
